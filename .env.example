# Salin menjadi .env.local (lokal) atau .env (Docker/VPS), lalu sesuaikan.
# Format: postgres://USER:PASSWORD@HOST:PORT/NAMA_DATABASE
DATABASE_URL=postgres://balita:ganti-kata-sandi-ini@localhost:5432/balita_center

# Nama tampilan organisasi (opsional)
NEXT_PUBLIC_APP_NAME=Balita Center

# Alamat publik aplikasi (untuk tautan di email & Connect)
APP_BASE_URL=https://balita.rotalogic.id

# Rahasia sesi login
AUTH_SECRET=

# Folder berkas unggahan (persisten)
UPLOAD_DIR=./uploads

# Token pemicu job tagihan terjadwal (cron). Buat: openssl rand -hex 24
# Nilainya sama dengan yang dipakai deploy/job-tagihan.sh di server.
JOB_TOKEN=

# Email keluar (tagihan SPP, pengingat, atur ulang kata sandi, undangan).
# Kosongkan bila belum ada SMTP — aplikasi tetap berjalan, email tercatat
# sebagai menunggu_kanal.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Cadangan kunci LLM Ailsa. Kunci utama diisi admin dari halaman Ailsa
# (kartu Kunci LLM — DeepSeek), env ini hanya fallback.
AILSA_LLM_API_KEY=
